i\nSomos la compañía líder a nivel nacional y una de las más reconocidas en el ámbito regional en la fabricación y comercialización de productos para ferretería y hogar. Ofrecemos productos de alta calidad, con resistencia y durabilidad, que aportan funcionalidad y embellecen los espacios que ocupan. Nuestro producto insignia son las duchas, contamos con un portafolio de productos y servicios que nos brinda la posibilidad de ofrecer a nuestros clientes y usuarios abanicos de posibilidades económicas y sofisticadas, acompañadas por un excelente servicio y una excelente calidad...","blockClass":"TextoBannerHome","textAlignment":"LEFT","textPosition":"LEFT"},"contentIds":["3DXGCMMH8vBHuku7HMEY6e~xrhvCavchvgX3i1hQkTxFH"]},"store.home\u002Fresponsive-layout.desktop#home\u002Fflex-layout.row#banner-seccion-home\u002Fflex-layout.col#banner-seccion-home-der\u002Fflex-layout.row#Slider-bannerMini":{"before":[],"around":[],"after":[],"blockId":"boccherinicol.tema-boccherini-xtrategik@2.x:flex-layout.row#Slider-bannerMini","blocks":[{"blockId":"boccherinicol.tema-boccherini-xtrategik@2.x:flex-layout.col#Slider-bannerMini","extensionPointId":"flex-layout.col#Slider-bannerMini","children":true,"blockRole":"children"}],"component":"vtex.flex-layout@0.21.6\u002FFlexLayout","composition":"children","hasContentSchema":false,"hydration":"always","implements":["vtex.flex-layout@0.x:flex-layout.row","vtex.flex-layout@0.x:flex-layout"],"preview":null,"props":{"blockClass":["threeBanner"],"fulwidth":true,"preventHorizontalStretch":true,"preventVerticalStretch":true,"preserveLayoutOnMobile":false,"horizontalAlign":"center","verticalAlign":"middle","paddingTop":6,"paddingBottom":6},"render":"server","track":[],"content":{"blockClass":["threeBanner"],"fulwidth":true,"preventHorizontalStretch":true,"preventVerticalStretch":true,"preserveLayoutOnMobile":false,"horizontalAlign":"center","verticalAlign":"middle","paddingTop":6,"paddingBottom":6},"contentIds":[""]},"store.home\u002Fresponsive-la